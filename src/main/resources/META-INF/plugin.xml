<idea-plugin>
    <id>com.codebecause.jetbrains</id>
    <name>CodeBecause</name>
    <vendor email="18881934641@163.com" url="https://github.com/HobbyBear/archscope-jetbrains">CodeBecause</vendor>

    <description><![CDATA[
        Analyze a user-defined business topic, then refine the resulting business-domain and end-to-end
        flow report interactively. Model execution is provider-neutral;
        the bundled default adapter uses an authenticated local Codex CLI.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.archscope.jetbrains.ui.ArchitectureReportFileEditorProvider"/>
        <toolWindow
                id="CodeBecause"
                anchor="right"
                icon="/icons/codebecause.svg"
                factoryClass="com.archscope.jetbrains.ui.ArchitectureToolWindowFactory"/>
        <codeInsight.lineMarkerProvider
                language="go"
                implementationClass="com.archscope.jetbrains.ui.FunctionFlowLineMarkerProvider"/>
    </extensions>

    <actions>
        <action
                id="ArchScope.OpenToolWindow"
                class="com.archscope.jetbrains.ui.OpenArchScopeAction"
                text="Open CodeBecause"
                description="Open CodeBecause business analysis">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="CodeBecause.AnalyzeFunctionFlow"
                class="com.archscope.jetbrains.ui.AnalyzeFunctionFlowAction"
                text="Analyze Function Business Flow"
                description="Analyze the selected function and its callees as a detailed business flow">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action
                id="CodeBecause.ShowFunctionAnalysisRun"
                class="com.archscope.jetbrains.ui.ShowFunctionAnalysisRunAction"
                text="Show Live Analysis"
                description="Reopen the active business or function analysis stream">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
