<idea-plugin>
    <id>com.codebecause.jetbrains</id>
    <name>CodeBecause</name>
    <vendor>CodeBecause</vendor>

    <description><![CDATA[
        Analyze selected Git changes or a user-defined business topic, then refine the resulting
        business-domain and end-to-end flow report interactively. Model execution is provider-neutral;
        the bundled default adapter uses an authenticated local Codex CLI.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="com.archscope.jetbrains.ui.ArchitectureReportFileEditorProvider"/>
        <toolWindow
                id="CodeBecause"
                anchor="right"
                icon="/icons/codebecause.svg"
                factoryClass="com.archscope.jetbrains.ui.ArchitectureToolWindowFactory"/>
    </extensions>

    <actions>
        <action
                id="ArchScope.OpenToolWindow"
                class="com.archscope.jetbrains.ui.OpenArchScopeAction"
                text="Open CodeBecause"
                description="Select Git commits and generate an architecture review">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action
                id="ArchScope.AnalyzeGitLogSelection"
                class="com.archscope.jetbrains.ui.AnalyzeGitLogSelectionAction"
                text="Analyze Selected Commits with AI"
                description="Analyze one or more commits selected in the Git log"
                icon="/icons/codebecause.svg">
            <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
